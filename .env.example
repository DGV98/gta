# gta-shorts secrets. Copy to .env (never commit it).
# Create a Twitch app at https://dev.twitch.tv/console (category: Other,
# OAuth redirect http://localhost). Put the same two values in openshorts/.env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Phase 3 (posting to TikTok): app.upload-post.com -> API Keys -> Generate New API Key.
UPLOAD_POST_API_KEY=
