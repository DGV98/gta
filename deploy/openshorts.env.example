# openshorts/.env: read by the backend container (python-dotenv; the repo is
# mounted at /app). scripts/setup_openshorts.sh copies this file once and
# never overwrites it afterwards.

# --- Keys --------------------------------------------------------------------
GEMINI_API_KEY=
# Same Twitch developer app as the gta-shorts CLI (dev.twitch.tv/console).
# Gives the moment picker the viewer-clip heat signal.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- GTA VI guidance (patch 0001) -------------------------------------------
# Container path: setup_openshorts.sh copies deploy/gta6_profile.txt there.
CLIP_PROFILE_FILE=/app/profiles/gta6.txt

# --- GPU (NVIDIA) ------------------------------------------------------------
# For a CPU-only test run, comment these four out (defaults: small/cpu/int8/x264).
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
FFMPEG_ENCODER=auto
ASR_GPU_CONCURRENCY=1
# ~2x faster transcription on GPU, English supported. Try it after the first
# runs look right; it falls back to whisper on errors.
# TRANSCRIBE_BACKEND=parakeet

# --- Jobs --------------------------------------------------------------------
# One GPU: one job at a time (openshorts sizes concurrency by free VRAM).
MAX_CONCURRENT_JOBS=1
# Disk cap for job outputs and kept sources, in GB (oldest finished jobs go first).
OUTPUT_MAX_GB=60
