# openshorts/.env: passed to the backend container (env_file in
# deploy/docker-compose.override.gpu.yml). scripts/setup_openshorts.sh copies
# this file once and never overwrites it afterwards. Edits take effect on the
# next scripts/up.sh.

# --- Keys --------------------------------------------------------------------
GEMINI_API_KEY=
# The model that scores windows, picks clips, writes hooks and checks each
# shot for the stacked layout. Same 12-min supertf stretch, GTA profile:
#   gemini-3.1-flash-lite (openshorts' default): $0.005 reported, 5 clips,
#     found the best moment but still used quoted lines as hooks.
#   gemini-3.5-flash: $0.073 reported, 7 clips, hooks that follow the profile.
# The reported figure (what max_usd_per_day counts) leaves out the per-shot
# layout checks, which bill on the same model: estimate ~$0.13 a stretch on
# 3.5-flash (~$1.60/day at 12 stretches) and ~$0.015 on flash-lite.
# GEMINI_MODEL=gemini-3.5-flash
# Same Twitch developer app as the gta-shorts CLI (dev.twitch.tv/console).
# Gives the moment picker the viewer-clip heat signal.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- GTA VI guidance (patch 0001) -------------------------------------------
# Container path: setup_openshorts.sh copies deploy/gta6_profile.txt there.
CLIP_PROFILE_FILE=/app/profiles/gta6.txt
# Keep the hooks the clip picker writes under the profile's rules. On, openshorts
# rewrites the hook of every stacked (screencast-layout) clip from three frames
# with a prompt meant for screen recordings, which on GTA names the map menu.
HOOK_GROUNDING=0

# --- GPU (NVIDIA) ------------------------------------------------------------
# For a CPU-only test run, comment these four out (defaults: small/cpu/int8/x264).
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
FFMPEG_ENCODER=auto
ASR_GPU_CONCURRENCY=1
# ~2x faster transcription on GPU, English supported. Try it after the first
# runs look right; it falls back to whisper on errors.
# TRANSCRIBE_BACKEND=parakeet

# --- Jobs --------------------------------------------------------------------
# One GPU: one job at a time (openshorts sizes concurrency by free VRAM).
MAX_CONCURRENT_JOBS=1
# Disk cap for job outputs and kept sources, in GB (oldest finished jobs go first).
OUTPUT_MAX_GB=60
