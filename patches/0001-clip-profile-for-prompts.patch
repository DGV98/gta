@@ -0,0 +1,84 @@
+"""CLIP_PROFILE_FILE: deployment guidance injected into the selection prompts.
+
+Pure logic: the real templates are read via ast (gemini_worker pulls
+google-genai, absent in the thin CI env), like test_generation_controls.
+"""
+import ast
+import os
+
+import content_profile
+
+PROFILE = """\
+# comment lines are dropped
+Shared line for every prompt.
+
+[score]
+Score loud chaos {high}.
+
+[detail]
+Hashtags: #GTA6
+
+[visual]
+Watch for crashes.
+
+[unknown]
+never used
+"""
+
+
+def _templates():
+    mod = ast.parse(open(os.path.join(os.path.dirname(__file__), "..",
+                                      "gemini_worker.py")).read())
+    return {
+        node.targets[0].id: node.value.value
+        for node in mod.body
+        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Constant)
+        and isinstance(node.targets[0], ast.Name)
+        and node.targets[0].id.endswith("_PROMPT_TEMPLATE")
+    }
+
+
+def test_parse_splits_sections_and_shares_the_preamble():
+    p = content_profile.parse(PROFILE)
+    assert p["score"] == "Shared line for every prompt.\n\nScore loud chaos {high}."
+    assert p["detail"].endswith("Hashtags: #GTA6")
+    assert p["visual"].startswith("Shared line")
+    assert "comment" not in p["score"] and "never used" not in p["detail"]
+
+
+def test_no_profile_leaves_templates_identical(monkeypatch):
+    monkeypatch.delenv("CLIP_PROFILE_FILE", raising=False)
+    t = _templates()
+    out = content_profile.apply_all(t["SCORE_PROMPT_TEMPLATE"], t["DETAIL_PROMPT_TEMPLATE"],
+                                    t["VISUAL_PROMPT_TEMPLATE"])
+    assert out == (t["SCORE_PROMPT_TEMPLATE"], t["DETAIL_PROMPT_TEMPLATE"],
+                   t["VISUAL_PROMPT_TEMPLATE"])
+
+
+def test_missing_file_is_not_fatal(tmp_path):
+    assert content_profile.load(str(tmp_path / "nope.txt")) == {
+        "score": "", "detail": "", "visual": ""}
+
+
+def test_profile_lands_before_the_data_block_and_still_formats(tmp_path):
+    path = tmp_path / "profile.txt"
+    path.write_text(PROFILE, encoding="utf-8")
+    t = _templates()
+    score, detail, visual = content_profile.apply_all(
+        t["SCORE_PROMPT_TEMPLATE"], t["DETAIL_PROMPT_TEMPLATE"],
+        t["VISUAL_PROMPT_TEMPLATE"], path=str(path))
+
+    s = score.format(video_duration=100, language="en", windows_json="[]")
+    assert "Score loud chaos {high}." in s          # braces survive .format
+    assert s.index("Score loud chaos") < s.index("TRANSCRIPT_LANGUAGE: en")
+    assert s.index("Score loud chaos") > s.index("THE 2-SECOND TEST")
+
+    d = detail.format(video_duration=100, language="en", min_clips=2, max_clips=4,
+                      min_secs=15.0, max_secs=60.0, windows_json="[]")
+    assert "Hashtags: #GTA6" in d
+    assert d.index("Hashtags: #GTA6") < d.index("CANDIDATE_WINDOWS_JSON")
+    assert "Score loud chaos" not in d
+
+    v = visual.format(video_duration=100, language="en", min_clips=2, max_clips=4,
+                      min_secs=15.0, max_secs=60.0)
+    assert v.rstrip().endswith("Watch for crashes.")
