+"""Deployment-wide editorial guidance for the clip-selection prompts.
+
+A self-hosted instance that only ever clips one kind of footage (one game, one
+show) knows things the generic prompts cannot: what a good moment looks like
+there, what to always skip, how the copy should read. ``CLIP_PROFILE_FILE``
+points at a plain-text file with up to three sections:
+
+    [score]
+    ...appended to the window-scoring prompt...
+
+    [detail]
+    ...appended to the clip-picking / copywriting prompt...
+
+    [visual]
+    ...appended to the silent-footage (vision) prompt...
+
+Text before the first header goes to all three. Lines starting with ``#`` are
+comments. Unset variable, missing file or empty sections: the templates are
+returned unchanged, so an instance without a profile behaves exactly as before.
+
+The guidance is inserted before the prompt's data block (``TRANSCRIPT_LANGUAGE:
+{language}``) so the model reads it alongside the rules rather than after the
+JSON contract, and braces are escaped so ``str.format`` leaves it alone.
+Standard library only: CI imports this without the ML stack.
+"""
+import os
+import re
+from typing import Dict, Tuple
+
+SECTIONS = ("score", "detail", "visual")
+_HEADER = re.compile(r"^\[(\w+)\]\s*$")
+DATA_ANCHOR = "\nTRANSCRIPT_LANGUAGE: {language}\n"
+HEADING = "DEPLOYMENT GUIDANCE (this instance clips one kind of footage; follow it):"
+
+
+def parse(text: str) -> Dict[str, str]:
+    """``{"score": ..., "detail": ..., "visual": ...}`` from a profile file's text."""
+    common, per = [], {s: [] for s in SECTIONS}
+    current = None
+    for raw in (text or "").splitlines():
+        line = raw.rstrip()
+        if line.lstrip().startswith("#"):
+            continue
+        m = _HEADER.match(line.strip())
+        if m:
+            name = m.group(1).lower()
+            current = name if name in per else "__ignored__"
+            continue
+        if current is None:
+            common.append(line)
+        elif current in per:
+            per[current].append(line)
+    shared = "\n".join(common).strip()
+    out = {}
+    for name in SECTIONS:
+        body = "\n".join(per[name]).strip()
+        out[name] = "\n\n".join(p for p in (shared, body) if p)
+    return out
+
+
+def load(path=None) -> Dict[str, str]:
+    """The profile named by ``path`` or ``CLIP_PROFILE_FILE``; empty sections if none."""
+    path = path if path is not None else os.environ.get("CLIP_PROFILE_FILE", "").strip()
+    if not path:
+        return {s: "" for s in SECTIONS}
+    try:
+        with open(path, encoding="utf-8") as f:
+            return parse(f.read())
+    except OSError as e:
+        print(f"   ⚠️ CLIP_PROFILE_FILE unreadable ({e}); prompts left unchanged.")
+        return {s: "" for s in SECTIONS}
+
+
+def _escape(text: str) -> str:
+    return text.replace("{", "{{").replace("}", "}}")
+
+
+def inject(template: str, guidance: str) -> str:
+    """``template`` with ``guidance`` added before its data block (or at the end)."""
+    if not guidance:
+        return template
+    block = f"\n{HEADING}\n{_escape(guidance)}\n"
+    if DATA_ANCHOR in template:
+        return template.replace(DATA_ANCHOR, block + DATA_ANCHOR, 1)
+    return template.rstrip("\n") + "\n" + block
+
+
+def apply_all(score: str, detail: str, visual: str, path=None) -> Tuple[str, str, str]:
+    """The three prompt templates with the deployment's profile applied."""
+    profile = load(path)
+    if any(profile.values()):
+        names = [s for s in SECTIONS if profile[s]]
+        print(f"   🧭 Clip profile applied to: {', '.join(names)}")
+    return (inject(score, profile["score"]),
+            inject(detail, profile["detail"]),
+            inject(visual, profile["visual"]))
