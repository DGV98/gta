diff --git a/tests/test_twitch_vod_stretch.py b/tests/test_twitch_vod_stretch.py
new file mode 100644
index 0000000..f0b584f
--- /dev/null
+++ b/tests/test_twitch_vod_stretch.py
@@ -0,0 +1,97 @@
+"""An uploaded stretch of a Twitch VOD keeps the viewer-clip signal.
+
+/api/process takes ``twitch_vod_url`` + ``twitch_vod_offset`` with an upload;
+the job env carries them and main.py shifts the VOD's viewer clips into the
+file's own seconds (twitch_signals.viewer_clips_for_stretch).
+"""
+import asyncio
+
+import httpx
+import pytest
+
+import twitch_signals
+
+VOD = "https://www.twitch.tv/videos/2600000001"
+
+
+def test_stretch_clips_are_shifted_into_file_time(monkeypatch):
+    monkeypatch.setattr(twitch_signals, "fetch_viewer_clips", lambda vid: [
+        {"start": 3700.0, "duration": 30.0, "views": 900},   # 100 s into the file
+        {"start": 3550.0, "duration": 20.0, "views": 50},    # wholly before it
+        {"start": 3595.0, "duration": 20.0, "views": 70},    # straddles the start
+    ])
+    out = twitch_signals.viewer_clips_for_stretch(VOD, "3600")
+    # Kept when the midpoint is inside the file, clamped to it (shift_clips).
+    assert out == [{"start": 100.0, "end": 130.0, "views": 900},
+                   {"start": 0.0, "end": 15.0, "views": 70}]
+
+
+def test_stretch_needs_a_vod_link(monkeypatch):
+    monkeypatch.setattr(twitch_signals, "fetch_viewer_clips",
+                        lambda vid: pytest.fail("must not call Helix"))
+    assert twitch_signals.viewer_clips_for_stretch("https://clips.twitch.tv/Abc", 0) == []
+
+
+app_module = pytest.importorskip("app")
+
+
+@pytest.fixture()
+def upload(tmp_path, monkeypatch):
+    out_root = tmp_path / "output"; up_root = tmp_path / "uploads"
+    out_root.mkdir(); up_root.mkdir()
+    monkeypatch.setattr(app_module, "OUTPUT_DIR", str(out_root))
+    monkeypatch.setattr(app_module, "UPLOAD_DIR", str(up_root))
+    monkeypatch.setattr(app_module, "_media_duration_seconds", lambda p: 720.0)
+
+    async def fake_put(item):
+        pass
+    monkeypatch.setattr(app_module.job_queue, "put", fake_put)
+
+    async def _make():
+        async with _client() as c:
+            slot = (await c.post("/api/uploads", json={"filename": "stretch.mp4"})).json()
+            r = await c.put(f"/api/uploads/{slot['upload_id']}", content=b"\x00" * 4096)
+            assert r.status_code == 200
+            return slot["upload_id"]
+    return asyncio.run(_make())
+
+
+def _client():
+    transport = httpx.ASGITransport(app=app_module.app)
+    return httpx.AsyncClient(transport=transport, base_url="http://testserver",
+                             headers={"X-Gemini-Key": "test-key"})
+
+
+def _process(body):
+    async def _do():
+        async with _client() as c:
+            return await c.post("/api/process", json=body)
+    return asyncio.run(_do())
+
+
+def test_process_puts_the_vod_ref_in_the_job_env(upload):
+    r = _process({"upload_id": upload, "acknowledged": True,
+                  "twitch_vod_url": VOD, "twitch_vod_offset": 3600})
+    assert r.status_code == 200, r.text
+    env = app_module.jobs[r.json()["job_id"]]["env"]
+    assert env["TWITCH_VOD_URL"] == VOD
+    assert env["TWITCH_VOD_OFFSET"] == "3600.000"
+
+
+def test_no_vod_ref_leaves_env_alone(upload):
+    r = _process({"upload_id": upload, "acknowledged": True})
+    assert r.status_code == 200, r.text
+    env = app_module.jobs[r.json()["job_id"]]["env"]
+    assert "TWITCH_VOD_URL" not in env and "TWITCH_VOD_OFFSET" not in env
+
+
+@pytest.mark.parametrize("vod_url,offset", [
+    ("https://www.twitch.tv/somebody", 0),        # channel page, not a VOD
+    ("https://example.com/videos/123", 0),        # not Twitch
+    (VOD, -5),
+    (VOD, "soon"),
+])
+def test_bad_vod_ref_is_a_400(upload, vod_url, offset):
+    r = _process({"upload_id": upload, "acknowledged": True,
+                  "twitch_vod_url": vod_url, "twitch_vod_offset": offset})
+    assert r.status_code == 400
