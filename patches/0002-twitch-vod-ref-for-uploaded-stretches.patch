+def viewer_clips_for_stretch(vod_url, offset_seconds) -> List[dict]:
+    """Viewer clips for an uploaded stretch of a VOD, in the file's own seconds.
+
+    For a caller that downloaded part of a VOD itself and uploads that file
+    (``twitch_vod_url`` + ``twitch_vod_offset`` on /api/process, set as
+    ``TWITCH_VOD_URL`` / ``TWITCH_VOD_OFFSET``): second 0 of the file is second
+    ``offset_seconds`` of the VOD. Clips past the end of the file land in no
+    transcript window and are ignored by ``window_heat``.
+    """
+    vod_id = parse_vod_id(vod_url)
+    if not vod_id:
+        return []
+    try:
+        start = max(0.0, float(offset_seconds or 0))
+    except (TypeError, ValueError):
+        start = 0.0
+    clips = fetch_viewer_clips(vod_id)
+    if not clips:
+        return []
+    shifted = shift_clips(clips, start, math.inf)
+    print(f"   👀 Twitch: {len(shifted)} viewer clip(s) from {start:.0f}s on "
+          f"({len(clips)} on the VOD).")
+    return shifted
