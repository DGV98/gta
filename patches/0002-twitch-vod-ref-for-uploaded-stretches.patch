+def _parse_twitch_vod_ref(vod_url, offset):
+    """``(vod_url, "<offset>")`` for an uploaded VOD stretch, None when absent.
+
+    400 on a link that is not a ``twitch.tv/videos/<id>`` VOD or an offset
+    that is not a non-negative number of seconds.
+    """
+    if vod_url in (None, ""):
+        return None
+    import twitch_signals
+    vod_url = str(vod_url).strip()
+    if not twitch_signals.parse_vod_id(vod_url):
+        raise HTTPException(status_code=400,
+                            detail="twitch_vod_url must be a twitch.tv/videos/<id> link.")
+    try:
+        start = float(offset) if offset not in (None, "") else 0.0
+    except (TypeError, ValueError):
+        raise HTTPException(status_code=400, detail="twitch_vod_offset must be seconds.")
+    if not (start >= 0.0) or start == float("inf"):
+        raise HTTPException(status_code=400, detail="twitch_vod_offset must be seconds.")
+    return vod_url, f"{start:.3f}"
+
