diff --git a/tests/test_stream_layout.py b/tests/test_stream_layout.py
new file mode 100644
index 0000000..ad10e7a
--- /dev/null
+++ b/tests/test_stream_layout.py
@@ -0,0 +1,132 @@
+"""STREAM_LAYOUT=1 (layouts=["stream"]): game-stream VODs never get cropped.
+
+On GTA VI streams the classifier's TRACK followed in-game characters and cut
+the streamer's corner overlay out of the frame, and GENERAL's centre strip cut
+a side webcam in half. The stream layout settles every scene from the webcam
+box alone: INSET where it shows, WIDE (the whole frame) everywhere else.
+"""
+import sys
+import types
+
+import pytest
+
+import reframe_v2
+from reframe_v2 import stream_layout_enabled, stream_strategies
+
+
+class FT:
+    """Stand-in for scenedetect's FrameTimecode."""
+
+    def __init__(self, frames):
+        self.frames = frames
+
+    def get_frames(self):
+        return self.frames
+
+
+class _Stop(Exception):
+    pass
+
+
+BOX = (0, 364, 281, 158)
+
+
+class TestStreamStrategies:
+    def test_inset_where_the_webcam_shows_whole_frame_elsewhere(self):
+        strategies, insets = stream_strategies(
+            [(0, 90), (90, 300), (300, 400)], BOX, lambda s, e: s != 90)
+        assert strategies == ['INSET', 'WIDE', 'INSET']
+        assert insets == {0: BOX, 300: BOX}
+
+    def test_no_webcam_means_the_whole_frame_and_no_presence_checks(self):
+        def present(s, e):
+            raise AssertionError("nothing to look for")
+        strategies, insets = stream_strategies([(0, 90), (90, 300)], None, present)
+        assert strategies == ['WIDE', 'WIDE'] and insets == {}
+
+    def test_never_a_cropping_layout(self):
+        for inset in (BOX, None):
+            for shows in (True, False):
+                strategies, _ = stream_strategies(
+                    [(0, 10), (10, 20)], inset, lambda s, e: shows)
+                assert set(strategies) <= {'INSET', 'WIDE'}
+
+
+class TestEnabled:
+    def test_off_unless_set_to_one(self, monkeypatch):
+        monkeypatch.delenv("STREAM_LAYOUT", raising=False)
+        assert not stream_layout_enabled()
+        monkeypatch.setenv("STREAM_LAYOUT", "0")
+        assert not stream_layout_enabled()
+        monkeypatch.setenv("STREAM_LAYOUT", "1")
+        assert stream_layout_enabled()
+
+
+@pytest.fixture
+def fake_main(monkeypatch):
+    """A `main` with just what render() touches before the trajectory pass."""
+    m = types.ModuleType("main")
+    m.detect_scenes = lambda path: ([(FT(0), FT(90)), (FT(90), FT(300))], 30.0)
+    m.get_video_resolution = lambda path: (1920, 1080)
+    m.calls = []
+    m.analyze_scenes_strategy = lambda path, scenes: m.calls.append("classifier") or ['TRACK', 'GENERAL']
+    m.SmoothedCameraman = lambda *a, **k: types.SimpleNamespace(crop_width=608, crop_height=1080)
+    m.SpeakerTracker = lambda **k: object()
+    monkeypatch.setitem(sys.modules, "main", m)
+    return m
+
+
+def _routed(monkeypatch, *, inset, shows, force=None):
+    """Run render() up to the trajectory pass; return the strategies it routed."""
+    seen = {}
+
+    def stop(video, boundaries, strategies, *a, **k):
+        seen["strategies"] = list(strategies)
+        raise _Stop()
+
+    monkeypatch.setattr(reframe_v2, "_analyze_trajectory", stop)
+    monkeypatch.setattr(reframe_v2.camera_inset, "detect", lambda path: inset)
+    monkeypatch.setattr(reframe_v2.camera_inset, "present_in_scene",
+                        lambda video, box, s, e: shows(s))
+    # The stream route skips the split check; an editor override keeps
+    # upstream's behaviour (it runs, finding nothing here).
+    monkeypatch.setattr(reframe_v2.split_layout, "detect_split_scenes",
+                        (lambda *a: {}) if force else
+                        (lambda *a: (_ for _ in ()).throw(AssertionError("no split check"))))
+    monkeypatch.setattr(reframe_v2.screencast_layout, "detect_content_ranges",
+                        lambda *a: (_ for _ in ()).throw(AssertionError("no Gemini shot check")))
+    with pytest.raises(_Stop):
+        reframe_v2.render("clip.mp4", "out.mp4", 9 / 16, force_strategy=force)
+    return seen["strategies"]
+
+
+class TestRenderRouting:
+    def test_webcam_scenes_stack_the_rest_keep_the_whole_frame(self, monkeypatch, fake_main):
+        monkeypatch.setenv("STREAM_LAYOUT", "1")
+        assert _routed(monkeypatch, inset=BOX, shows=lambda s: s == 0) == ['INSET', 'WIDE']
+        assert fake_main.calls == []          # the face classifier never ran
+
+    def test_no_webcam_is_the_whole_frame_in_every_scene(self, monkeypatch, fake_main):
+        monkeypatch.setenv("STREAM_LAYOUT", "1")
+        assert _routed(monkeypatch, inset=None, shows=lambda s: True) == ['WIDE', 'WIDE']
+
+    def test_an_editor_framing_override_still_wins(self, monkeypatch, fake_main):
+        monkeypatch.setenv("STREAM_LAYOUT", "1")
+        assert _routed(monkeypatch, inset=BOX, shows=lambda s: True,
+                       force='TRACK') == ['TRACK', 'TRACK']
+
+    def test_without_the_flag_the_classifier_decides_as_before(self, monkeypatch, fake_main):
+        monkeypatch.delenv("STREAM_LAYOUT", raising=False)
+        monkeypatch.setattr(reframe_v2.screencast_layout, "ENABLED", False)
+        monkeypatch.setattr(reframe_v2, "_analyze_trajectory",
+                            lambda *a, **k: (_ for _ in ()).throw(_Stop()))
+        monkeypatch.setattr(reframe_v2.split_layout, "detect_split_scenes", lambda *a: {})
+        with pytest.raises(_Stop):
+            reframe_v2.render("clip.mp4", "out.mp4", 9 / 16)
+        assert fake_main.calls == ["classifier"]
+
+
+class TestLayoutEnvStream:
+    def test_stream_switches_the_layout_on_for_the_job(self):
+        app_module = pytest.importorskip("app")
+        assert app_module.layout_env(["stream"]) == {"STREAM_LAYOUT": "1"}
