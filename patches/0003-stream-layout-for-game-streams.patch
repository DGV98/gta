+def stream_layout_enabled():
+    """STREAM_LAYOUT=1, set per job by ``layouts=["stream"]``: a game stream.
+
+    The classifier frames gameplay badly in both of its answers. GENERAL keeps
+    a centre strip and crops ~24% off the sides, which is where streamers put
+    their webcam. TRACK follows a face, and in a modern game the characters ARE
+    faces: on GTA VI it followed Lucia across a cutscene and cut the streamer's
+    overlay out of the frame. The screencast route fixes the webcam case but
+    asks Gemini about every shot, and when that check fails (quota, outage) its
+    fallback leaves the TRACK verdicts in place. Read at call time so a job's
+    environment (or a test) decides.
+    """
+    return os.environ.get("STREAM_LAYOUT", "0").strip() == "1"
+
+
+def stream_strategies(scene_boundaries, inset, present):
+    """Per-scene layouts for a stream: INSET (the whole frame on top, the webcam
+    enlarged below) where the corner webcam ``inset`` is in the scene, WIDE (the
+    whole frame) everywhere else. Never TRACK or GENERAL, so nothing at the
+    sides is ever cropped away: a streamer without a webcam (an avatar, a
+    PNGTuber) keeps their overlay in the full frame.
+
+    ``present(start_f, end_f)`` says whether the inset shows in that scene.
+    Returns ``(strategies, insets)``, insets keyed by scene start frame like
+    the screencast route's.
+    """
+    strategies, insets = [], {}
+    for start_f, end_f in scene_boundaries:
+        if inset and present(start_f, end_f):
+            strategies.append('INSET')
+            insets[start_f] = inset
+        else:
+            strategies.append('WIDE')
+    return strategies, insets
+
+
